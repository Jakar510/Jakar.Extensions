<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Jakar.Json and Jakar.Spans until they're on nuget.org: dotnet pack in their repositories, then nuget add <nupkg> -Source W:\WorkSpace\LocalNuGet -->
    <add key="LocalNuGet" value="W:\WorkSpace\LocalNuGet" />
  </packageSources>
</configuration>
