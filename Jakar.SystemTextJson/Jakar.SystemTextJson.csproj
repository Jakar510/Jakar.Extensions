<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Types stay in the Jakar.Extensions namespace, as every package split out of Jakar.Extensions does (MigrationPlan.md). -->
		<RootNamespace>Jakar.Extensions</RootNamespace>
		<AssemblyName>Jakar.SystemTextJson</AssemblyName>
		<Version>1.0.0</Version>
		<Title>Jakar.SystemTextJson</Title>
		<PackageId>Jakar.SystemTextJson</PackageId>
		<Authors>Tyler Stegmaier</Authors>
		<Description>Native AOT friendly System.Text.Json models: IJsonModel&lt;TSelf&gt;, the [JsonModel] source generator, and pooled element-wise JSON arrays.</Description>
		<PackageTags>json System.Text.Json source-generator aot trimming</PackageTags>
		<PackageReleaseNotes>1.0.0: initial release (split out of Jakar.Extensions 11.0).</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Jakar510/Jakar.Extensions</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Jakar510/Jakar.Extensions</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<WarningsAsErrors>Nullable;IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2111;IL3050;IL3051</WarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- Keep the JetBrains annotations ([MustDisposeResource], [Pure], ...) in the compiled metadata so Rider/ReSharper users see them. -->
		<DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" />
	</ItemGroup>

	<!-- The generator, analyzers and code fixes ship inside this package (analyzers/dotnet/cs). -->
	<ItemGroup>
		<ProjectReference Include="..\Jakar.SystemTextJson.Generator\Jakar.SystemTextJson.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\Jakar.SystemTextJson.Generator.CodeFixes\Jakar.SystemTextJson.Generator.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Jakar.SystemTextJson.Generator\bin\$(Configuration)\netstandard2.0\Jakar.SystemTextJson.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\Jakar.SystemTextJson.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\Jakar.SystemTextJson.Generator.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
